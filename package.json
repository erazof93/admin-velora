    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^4.1.2",
    "jsdom": "^25.0.1",
    "oxlint": "^1.81.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
